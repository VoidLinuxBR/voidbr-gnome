pkgname=voidbr-gnome
pkgdesc="VoidBR GNOME Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=()  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=() # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	voidbr-base-common
	voidbr-xorg-common
	voidbr-gui-common
	voidbr-wayland-common
	voidbr-change-gnome-wallpaper
	voidbr-gnome-config
	"colord"                   # Gerenciador de perfis de cores
	"extension-manager"        # App para gerenciar extensões sem navegador
	"gdm"                      # Gerenciador de login (Display Manager)
	"gnome"                    # Meta-pacote Core (Shell, Nautilus, Control Center)
	"gnome-apps"               # Suite de aplicativos padrão (Calculadora, Mapas, etc.)
	"gnome-backgrounds"        # Papéis de parede oficiais do GNOME
	"gnome-bluetooth"          # Interface de controle do Bluetooth no GNOME
	"gnome-browser-connector"  # Integração do navegador com extensões do Shell
	"gnome-characters"         # Utilitário de mapa de caracteres e emojis
	"gnome-connections"        # Cliente nativo para conexões remotas RDP/VNC
	"gnome-disk-utility"       # Utilitário para gerenciamento de discos e partições
	"gnome-keyring"            # Gerenciador de senhas, chaves SSH e GPG
	"gnome-online-accounts"    # Configuração central de contas externas
	"gnome-session"            # Gerenciador de sessão do GNOME
	"gnome-shell-extensions"   # Extensões oficiais fornecidas pelo projeto GNOME
	"gnome-system-monitor"     # Monitor de processos e recursos do sistema
	"gnome-terminal"           # Emulador de terminal padrão do GNOME
	"gnome-themes-extra"       # Temas extras para compatibilidade GTK2 e GTK3
	"mime-types"               # Fornece o arquivo compartilhado /etc/mime.types
	"polkit"                   # Framework para definição de privilégios
	"simple-scan"              # Utilitário de digitalização de documentos
	"tracker3"                 # Motor de busca e indexação de arquivos
	"tracker3-miners"          # Extratores de metadados para busca do Tracker
	"xdg-desktop-portal-gnome" # Integração de interface e permissões para Wayland
	"accountsservice"          # D-Bus interfaces for querying and manipulating user account information
)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
