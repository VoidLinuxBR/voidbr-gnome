	gnome-browser-connector       # Integração do navegador com extensões do Shell
	extension-manager             # Favorito na barra; gerencia extensões sem navegador
	gnome-terminal                # Terminal padrão (favorito org.gnome.Terminal.desktop)
	xfce4-terminal                # Terminal alternativo
	gnome-system-monitor          # Monitor de processos e recursos
	gnome-disk-utility            # Discos e partições
	gnome-characters              # Mapa de caracteres e emojis
	gnome-connections             # Cliente RDP/VNC
	gnome-online-accounts         # Contas externas
	gnome-bluetooth               # Bluetooth nas Configurações e no Shell
	gnome-themes-extra            # Compatibilidade GTK2/GTK3
	gnome-backgrounds             # Papéis de parede oficiais do GNOME
	simple-scan                   # Digitalização de documentos
	tracker3                      # Busca e indexação de arquivos
	tracker3-miners               # Extratores de metadados do Tracker
	colord                        # Perfis de cores
	mime-types                    # /etc/mime.types
	accountsservice               # Contas de usuário via D-Bus (Configurações > Usuários)
	voidbr-gnome-config           # Skel e padrões (gschema override, tema do Shell em ilhas)
	voidbr-gnome-shell-extension-dash-to-panel # Barra única embaixo, em ilhas
	voidbr-change-gnome-wallpaper # Slideshow em /usr/share/backgrounds/voidbr
	python3-gobject               # voidbr-gnome-tweaks (GTK4)
	gtk4                          # voidbr-gnome-tweaks

