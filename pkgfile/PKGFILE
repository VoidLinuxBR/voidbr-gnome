	voidbr-tokyo-theme     # Tokyonight-Dark-Theme, Tokyonight-Dark-Icons (GTK e Shell)
	voidbr-wallpapers      # Papel de parede (voidbr-wallpaper.avif)
	adwaita-icon-theme     # Ícones de reserva (os Tokyonight herdam de "gnome")
	libavif                # Abre o .avif do papel de parede (gdk-pixbuf)
	libheif-pixbuf-loader  # Loader AVIF/HEIF do gdk-pixbuf
