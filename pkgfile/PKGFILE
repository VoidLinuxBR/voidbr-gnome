	mesa-dri
	mesa-nouveau-dri
	mesa-vaapi

	# --- Wayland ---
	xorg-server-xwayland     # Apps X11 no Wayland
	qt5-wayland
	qt6-wayland
	wl-clipboard
	xdg-desktop-portal
	xdg-desktop-portal-gnome # Captura de tela, seletor de arquivos, color-scheme
	xdg-desktop-portal-gtk

